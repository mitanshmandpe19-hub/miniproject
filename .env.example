# ==============================================================================
# REQUIRE Application - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Required on Render / Local Server)
# ------------------------------------------------------------------------------
# Port for the Express server (Render sets PORT automatically)
PORT=3001

# Google Gemini API Key (Required for AI requirement audits)
# Get a key for free at https://aistudio.google.com/
GEMINI_API_KEY=

# Secret key used for signing JWT authentication tokens
JWT_SECRET=

# Allowed Frontend URL(s) for CORS (comma-separated if multiple, or * for all)
# Example for Render: https://your-app.vercel.app
FRONTEND_URL=

# Environment mode (development / production)
NODE_ENV=development

# ------------------------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Required on Vercel / Vite Client)
# ------------------------------------------------------------------------------
# Deployed Backend API URL
# Example for Vercel: https://your-backend.onrender.com
# In local development, leave this empty to use the Vite dev proxy
VITE_API_URL=
