# ==============================================================================
# REQUIRE Backend Server - Environment Configuration Template (Render / Server)
# ==============================================================================

# Port the Express server listens on (Render automatically supplies $PORT)
PORT=3001

# Google Gemini API Key (Required for analyzing requirements)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Secret key used for signing JWT session tokens
JWT_SECRET=

# Allowed Frontend URL for CORS (e.g., https://your-frontend.vercel.app)
FRONTEND_URL=

# Environment mode
NODE_ENV=development
